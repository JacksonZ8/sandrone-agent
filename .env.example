# 可选：覆盖 SQLite 数据库路径。默认使用项目根目录 data/sandrone_agent.db
# SANDRONE_DATABASE_URL=sqlite:///./data/sandrone_agent.db

# 可选：最近直接进入上下文的对话条数
# SANDRONE_RECENT_MESSAGE_LIMIT=40

# 可选：联想召回的旧情景记忆条数
# SANDRONE_EPISODIC_RECALL_LIMIT=4

# 可选：注入上下文的语义记忆条数
# SANDRONE_SEMANTIC_MEMORY_LIMIT=10

# 可选：覆盖 iLink 微信服务地址（默认 https://ilinkai.weixin.qq.com）
# SANDRONE_WECHAT_BASE_URL=https://ilinkai.weixin.qq.com


# TTS：默认 api 模式，按需拉起本机 GPT-SoVITS api_v2；没有 GPT-SoVITS 时用 mock（提示音代替）
# SANDRONE_TTS_MODE=api
# SANDRONE_GPT_SOVITS_DIR=../GPT-SoVITS
# SANDRONE_GPT_SOVITS_PYTHON=../GPT-SoVITS/.venv/bin/python

# 手机远程访问（Tailscale Serve）时允许的 tailnet 登录名，多个用逗号分隔；不设置则拒绝所有远程请求
# SANDRONE_TAILSCALE_LOGINS=your-login@github
